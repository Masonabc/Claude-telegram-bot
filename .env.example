# Main bot configuration
TELEGRAM_TOKEN=your_telegram_bot_token
ALLOWED_CHAT_IDS=123456789,987654321
PROJECTS_DIR=/home/user

# Feishu channel (optional; WebSocket long connection, no public URL needed)
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxx
# FEISHU_ALLOWED_IDS=ou_xxxxxxxx        # 逗号分隔; ou_=私聊用户 open_id, oc_=群 chat_id

# Optional overrides
# CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep,Task,Write,Edit,Bash
# CODEX_MODEL=gpt-5.3-codex
# GEMINI_MODEL=gemini-3.1-pro-preview
# BOT_INDICATOR=🤖
